<UserControl x:Class="Dopamine.Views.Common.EditTrackLyricsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pc="clr-namespace:Dopamine.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
            <!-- Get the lyrics from an online source and put them in the box below. -->
            <Button DockPanel.Dock="Right" Style="{StaticResource TransparentButton}"
                    Command="{Binding GetLyricsFromOnlineCommand}"
                    ToolTip="{DynamicResource Language_Get_Lyrics_From_Online}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource SegoeAssets}" FontSize="15"
                               VerticalAlignment="Center" Foreground="{DynamicResource Brush_SecondaryText}" />
                    <TextBlock Margin="5,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush_SecondaryText}"
                               Text="{DynamicResource Language_Get_Lyrics_From_Online}" />
                </StackPanel>
            </Button>
            <TextBlock Text="{DynamicResource Language_Lyrics}" Foreground="{DynamicResource Brush_PrimaryText}" VerticalAlignment="Center"/>
        </DockPanel>
        <pc:AccentTextBox VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding Lyrics.Value,UpdateSourceTrigger=PropertyChanged}" ShowAccent="{Binding Lyrics.IsValueChanged}"/>
    </DockPanel>
</UserControl>
