<UserControl x:Class="Dopamine.Views.Common.PasswordDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="320">
    <StackPanel>
        <TextBlock Text="{DynamicResource Language_Enter_Password}" Foreground="{DynamicResource Brush_PrimaryText}" TextWrapping="Wrap"/>
        <PasswordBox x:Name="PasswordInput" Margin="0,10,0,0" Height="30" VerticalContentAlignment="Center" Style="{DynamicResource MetroPasswordBox}"/>
    </StackPanel>
</UserControl>
