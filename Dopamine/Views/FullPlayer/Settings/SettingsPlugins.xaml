<UserControl x:Class="Dopamine.Views.FullPlayer.Settings.SettingsPlugins"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5" Padding="15" PanningMode="Both">
        <StackPanel>
            <Label Style="{StaticResource TitleLabel}" Content="{DynamicResource Language_Plugins}" />
            <TextBlock Margin="0,5,0,0"
                       Text="{DynamicResource Language_Plugins_Description}"
                       Foreground="{DynamicResource Brush_PrimaryText}"
                       TextWrapping="Wrap" />

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <Button Content="{DynamicResource Language_Refresh}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource RegularButton}"
                        MinWidth="100"
                        Margin="0,0,10,0" />
                <Button Content="{DynamicResource Language_Open_Plugins_Folder}"
                        Command="{Binding OpenPluginsFolderCommand}"
                        Style="{StaticResource RegularButton}"
                        MinWidth="150" />
            </StackPanel>

            <TextBlock Margin="0,16,0,0"
                       Text="{DynamicResource Language_No_Plugins_Found}"
                       Foreground="{DynamicResource Brush_SecondaryText}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasPlugins, Converter={StaticResource InvertingBooleanToVisibilityConverter}}" />

            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Plugins}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="14"
                                Background="{DynamicResource Brush_ItemHovered}"
                                BorderBrush="{DynamicResource Brush_ItemSeparator}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush_PrimaryText}"
                                                   VerticalAlignment="Center" />
                                        <Border Margin="10,0,0,0"
                                                Padding="7,1"
                                                CornerRadius="4"
                                                Background="{DynamicResource Brush_ItemSelected}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Version}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Brush_SecondaryText}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding KindDisplay}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush_SecondaryText}" />

                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding Description}"
                                               Foreground="{DynamicResource Brush_PrimaryText}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding Directory}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush_SecondaryText}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{DynamicResource Language_Open_Folder}"
                                        Command="{Binding OpenFolderCommand}"
                                        Style="{StaticResource RegularButton}"
                                        MinWidth="110"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
