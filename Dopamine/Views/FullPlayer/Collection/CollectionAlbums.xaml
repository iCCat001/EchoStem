<baseviews:TracksViewBase x:Class="Dopamine.Views.FullPlayer.Collection.CollectionAlbums"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
                          xmlns:baseviews="clr-namespace:Dopamine.Views.Common.Base"
                          xmlns:pc="clr-namespace:Dopamine.Controls"
                          xmlns:corebase="clr-namespace:Dopamine.Core.Base;assembly=Dopamine.Core"
                          xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
                          xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                          mc:Ignorable="d"
                          d:DesignHeight="300" d:DesignWidth="300"
                          prismMvvm:ViewModelLocator.AutoWireViewModel="True">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Unloaded">
            <i:InvokeCommandAction Command="{Binding UnloadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid x:Name="RootGrid" ClipToBounds="True" Background="Transparent"
          Loaded="RootGrid_Loaded"
          SizeChanged="RootGrid_SizeChanged">

        <!-- Album wall. Is translated to the left when the details pane is opened. -->
        <Grid x:Name="AlbumsPane">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="AlbumsPaneTranslate" />
            </Grid.RenderTransform>
            <DockPanel Margin="10,20,10,26">
                <DockPanel DockPanel.Dock="Top" Margin="10,0,10,20">
                    <TextBlock Text="{Binding AlbumsCount}" FontSize="13"
                               Foreground="{DynamicResource Brush_Accent}" DockPanel.Dock="Left"/>
                    <Button x:Name="ShuffleAllButton" DockPanel.Dock="Right" Margin="20,0,0,0" FontSize="13" 
                                Style="{StaticResource TransparentButton}" 
                                VerticalContentAlignment="Center" ToolTip="{DynamicResource Language_Shuffle_All}" 
                                Command="{Binding DataContext.ShuffleAllCommand,RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B1;" Style="{StaticResource SegoeAssets}" FontSize="16"
                                       Margin="0,1,5,0" Foreground="{DynamicResource Brush_SecondaryText}" />
                            <TextBlock FontSize="13" Text="{DynamicResource Language_Shuffle_All}"
                                       Foreground="{DynamicResource Brush_SecondaryText}"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Content="{Binding AlbumOrderText}" 
                            Style="{StaticResource TransparentButton}"
                            FontSize="13" 
                            Margin="10,0,0,0"
                            Foreground="{DynamicResource Brush_SecondaryText}"
                            Command="{Binding ToggleAlbumOrderCommand}" ToolTip="{DynamicResource Language_Toggle_Album_Order}"/>
                    <Button x:Name="AlbumsButton" Content="{DynamicResource Language_Albums}" FontSize="13" Margin="10,0,0,0"
                            Style="{StaticResource TransparentButton}"
                            Foreground="{DynamicResource Brush_PrimaryText}"
                            Click="AlbumsButton_Click" ToolTip="{DynamicResource Language_Select_None}"/>
                </DockPanel>
                <dc:MultiSelectListBox x:Name="ListBoxAlbums"
                                       Style="{StaticResource ListBoxAlbums}"
                                       BorderThickness="0"
                                       MouseDoubleClick="ListBoxAlbums_MouseDoubleClick"
                                       PreviewKeyDown="ListBoxAlbums_PreviewKeyDown" 
                                       SelectionMode="Extended"
                                       SelectionChanged="ListBoxAlbums_SelectionChanged"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       ItemsSource="{Binding AlbumsCvs.View}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding SelectedAlbumsCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=SelectedItems}"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="PreviewMouseRightButtonDown">
                            <i:InvokeCommandAction Command="{Binding DelaySelectedAlbumsCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </dc:MultiSelectListBox>
            </DockPanel>

            <!-- Dim + click-to-close overlay, shown when the details pane is opened. -->
            <Border x:Name="AlbumsDimOverlay" Panel.ZIndex="10"
                    Background="Black"
                    Opacity="0" IsHitTestVisible="False"
                    MouseLeftButtonDown="AlbumsDimOverlay_MouseLeftButtonDown"/>
        </Grid>

        <!-- Floating cover of the selected album. Shown above the dimming overlay, so it
             is not dimmed. It stays centered in the visible (left) part of the album wall. -->
        <Grid x:Name="FloatingCover" Panel.ZIndex="15"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              IsHitTestVisible="False" Opacity="0">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="FloatingCoverScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="FloatingCoverTranslate" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Border Width="{Binding CoverSize, Converter={StaticResource PercentSizeConverter}, ConverterParameter=250}"
                    Height="{Binding CoverSize, Converter={StaticResource PercentSizeConverter}, ConverterParameter=250}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Brush_Accent}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" Opacity="0.85" ShadowDepth="0" />
                </Border.Effect>
                <pc:SourceChangedImage Stretch="Uniform">
                    <pc:SourceChangedImage.Source>
                        <MultiBinding Converter="{StaticResource PathToImageConverter}">
                            <Binding Path="FloatingCoverArtworkPath" RelativeSource="{RelativeSource AncestorType={x:Type baseviews:TracksViewBase}}" />
                            <Binding Path="CoverSize" Converter="{StaticResource PercentSizeConverter}" ConverterParameter="600" />
                        </MultiBinding>
                    </pc:SourceChangedImage.Source>
                </pc:SourceChangedImage>
            </Border>
        </Grid>

        <!-- Details pane (tracks of the selected albums). Slides in from the right. -->
        <Border x:Name="TracksPane" Panel.ZIndex="20"
                HorizontalAlignment="Right"
                Background="{DynamicResource Brush_PaneBackground}">
            <Border.RenderTransform>
                <!-- Kept off-screen until the pane is laid out for the first time. -->
                <TranslateTransform x:Name="TracksPaneTranslate" X="10000" />
            </Border.RenderTransform>
            <DockPanel Margin="10,20,10,26">
                <DockPanel DockPanel.Dock="Top" Margin="10,0,10,20">
                    <TextBlock Text="{Binding TracksCount}" FontSize="13"
                           Foreground="{DynamicResource Brush_Accent}" DockPanel.Dock="Left"/>
                    <TextBlock Text="{DynamicResource Language_Songs}" FontSize="13" Margin="10,0,0,0"
                           Foreground="{DynamicResource Brush_PrimaryText}" />
                </DockPanel>
                <DockPanel>
                    <pc:TotalsInformation
                            DockPanel.Dock="Bottom"
                            Margin="10,20,10,0" 
                            Foreground="{DynamicResource Brush_SecondaryText}" 
                            FontSize="13"
                            TotalDurationInformation="{Binding TotalDurationInformation}"
                            TotalSizeInformation="{Binding TotalSizeInformation}"/>
                    <!-- Album actions: play the album (replaces the queue) and add it to now playing -->
                    <Grid DockPanel.Dock="Bottom" Margin="10,15,10,0">
                        <Button HorizontalAlignment="Left"
                                Style="{StaticResource TransparentButton}"
                                VerticalContentAlignment="Center"
                                ToolTip="{DynamicResource Language_Play_Album}"
                                Command="{Binding PlaySelectedAlbumsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource SegoeAssets}" FontSize="16"
                                           Margin="0,1,5,0" Foreground="{DynamicResource Brush_Accent}" />
                                <TextBlock FontSize="13" Text="{DynamicResource Language_Play_Album}"
                                           Foreground="{DynamicResource Brush_Accent}"/>
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Right"
                                Content="{DynamicResource Language_Add_To_Now_Playing}"
                                Style="{StaticResource TransparentButton}"
                                FontSize="13"
                                Foreground="{DynamicResource Brush_SecondaryText}"
                                ToolTip="{DynamicResource Language_Add_To_Now_Playing}"
                                Command="{Binding AddAlbumsToNowPlayingCommand}"/>
                    </Grid>
                    <dc:MultiSelectListBox x:Name="ListBoxTracks"
                                                         VirtualizingStackPanel.IsVirtualizing="True"
                                                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                                         VirtualizingStackPanel.VirtualizationMode="Recycling"                       
                                                         Style="{StaticResource ListBoxAlbumDetailsTracks}"
                                                         ItemsSource="{Binding TracksCvs.View}"
                                                         Loaded="ListBoxTracks_Loaded"
                                                         PreviewMouseLeftButtonDown="ListBoxTracks_PreviewMouseLeftButtonDown"
                                                         PreviewMouseLeftButtonUp="ListBoxTracks_PreviewMouseLeftButtonUp"
                                                         PreviewKeyDown="ListBoxTracks_PreviewKeyDown"
                                                         KeyUp="ListBoxTracks_KeyUp"
                                                         BorderThickness="0"
                                                         SelectionMode="Extended">
                        <dc:MultiSelectListBox.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding RemoveSelectedTracksCommand}" />
                        </dc:MultiSelectListBox.InputBindings>
                        <dc:MultiSelectListBox.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource TracksHeader}" />
                        </dc:MultiSelectListBox.GroupStyle>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SelectedTracksCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=SelectedItems}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </dc:MultiSelectListBox>
                </DockPanel>
            </DockPanel>
        </Border>
    </Grid>
</baseviews:TracksViewBase>
