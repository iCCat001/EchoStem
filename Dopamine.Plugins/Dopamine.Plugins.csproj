      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!--
    A project reference does not reliably flow content items into the WPF
    application's output under this legacy project format, so the bundled
    plugin packages are copied explicitly into Dopamine\bin\<Configuration>.
    The application reads them from that Plugins folder at runtime.
  -->
  <Target Name="CopyPluginPackagesToAppOutput" AfterTargets="Build" Condition="Exists('..\Dopamine\bin\$(Configuration)')">
    <ItemGroup>
      <PluginPackageFiles Include="Plugins\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginPackageFiles)" DestinationFiles="@(PluginPackageFiles->'..\Dopamine\bin\$(Configuration)\Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
