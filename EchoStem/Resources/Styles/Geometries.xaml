<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Window buttons -->
    <Geometry x:Key="MiniPlayer">F1M0,0L0,10 6,10 6,3 10,3 10,0 0,0 0,1 9,1 9,3 6,3 6,9 1,9 1,1 M5,3L5,13 13,13 13,3 5,3 5,4 12,4 12,12 6,12 6,4z</Geometry>
    <Geometry x:Key="Minimize">F1M0,3L10,3 9,2 0,2z</Geometry>
    <Geometry x:Key="Restore">F1M0,2L0,10 8,10 8,2 0,2 0,3 7,3 7,9 1,9 1,3 M2,0L2,3 8,3 8,8 10,8 10,0 2,0 2,1 9,1 9,7 8,7 8,3 3,3 3,1z</Geometry>
    <Geometry x:Key="Maximize">F1M0,0L0,10 10,10 10,0 0,0 0,1 9,1 9,9 1,9 1,1z</Geometry>
    <Geometry x:Key="Close">F1M0.6,0L10,9.4 9.4,10 0,0.6 0.6,0 M9.4,0L10,0.6 0.6,10 0,9.4 9.4,0z</Geometry>

    <!--
        EchoStem brand mark (from the design SVG, 200 x 200 coordinate system).
        Background: asymmetric rounded square (small corners top-left / bottom-right,
        large corners top-right / bottom-left).
        Inner frame: same shape, inset, drawn as a thin translucent white stroke.
        Bars: 5 rounded white bars (a "stem" of an echo waveform).
    -->
    <Geometry x:Key="BrandMarkBackground">M8,0 L144,0 A56,56 0 0 1 200,56 L200,192 A8,8 0 0 1 192,200 L56,200 A56,56 0 0 1 0,144 L0,8 A8,8 0 0 1 8,0 Z</Geometry>
    <Geometry x:Key="BrandMarkInnerFrame">M10,8 L142,8 A50,50 0 0 1 192,58 L192,190 A2,2 0 0 1 190,192 L58,192 A50,50 0 0 1 8,142 L8,10 A2,2 0 0 1 10,8 Z</Geometry>
    <GeometryGroup x:Key="BrandMarkBars">
        <RectangleGeometry Rect="29,88,18,34" RadiusX="9" RadiusY="9"/>
        <RectangleGeometry Rect="59,52,18,96" RadiusX="9" RadiusY="9"/>
        <RectangleGeometry Rect="89,70,18,60" RadiusX="9" RadiusY="9"/>
        <RectangleGeometry Rect="119,38,18,124" RadiusX="9" RadiusY="9"/>
        <RectangleGeometry Rect="149,96,18,26" RadiusX="9" RadiusY="9"/>
    </GeometryGroup>

    <!--
        Album-tile placeholder: only the spectrum bars, no background shape (used where an album has
        no artwork). The bars fill the tile better than the full mark would.
    -->
    <GeometryGroup x:Key="BrandMarkPlaceholder">
        <RectangleGeometry Rect="15,70,26,60" RadiusX="13" RadiusY="13"/>
        <RectangleGeometry Rect="51,40,26,120" RadiusX="13" RadiusY="13"/>
        <RectangleGeometry Rect="87,55,26,90" RadiusX="13" RadiusY="13"/>
        <RectangleGeometry Rect="123,30,26,140" RadiusX="13" RadiusY="13"/>
        <RectangleGeometry Rect="159,72,26,56" RadiusX="13" RadiusY="13"/>
    </GeometryGroup>
</ResourceDictionary>
